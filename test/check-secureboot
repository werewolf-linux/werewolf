#!/bin/sh
# check-secureboot QEMU... proves the release's UKI end to end (make
# check-secureboot; docs/design/verified-boot.md). make's uki rule signs
# minimal's kernel, stage0, root and command line into one PE with the
# boot key (tools/uki, osslsigncode); the release manifest must list it
# with the hash of what was built; firmware with Secure Boot on and only
# the test key enrolled must boot it with its posture judged; and the
# same image with one byte changed must be refused, Access Denied, and
# never hand over. make passes CHECK_ENV, BOOT_KEY, BOOT_CRT (Makefile).
set -eu
dir=${SECUREBOOT_DIR:-}
key=${BOOT_KEY:?}
crt=${BOOT_CRT:?}
uki=$OUT/slot/uki.efi
guid=a0420f26-3a13-4a1b-9c77-134e29b24bf1
log=$CHECK/secureboot.log

say() { echo "skip   secureboot        $*"; exit 0; }
fail() { echo "FAIL   secureboot        $1; see $log"; exit 1; }
[ -n "$dir" ] || say "no SECUREBOOT_DIR (docs/testing.md)"
for f in "$dir/stub.efi" "$dir/code.fd" "$dir/vars.fd" "$uki"; do
	[ -f "$f" ] || say "no $f"
done
command -v osslsigncode >/dev/null || say "no osslsigncode"

# The release: its manifest lists the UKI with the hash of what was built.
# --build takes this checkout's forms, for as long as its format is ahead
# of the repository's.
rel=$CHECK/sb-release
rm -rf "$rel"
build/host/howl build --build --with prod -o "$rel" >/dev/null ||
	fail "the release would not build"
python3 - "$rel/prod-$ARCH.json" "$uki" <<'EOF' || fail "the manifest does not carry the UKI"
import hashlib
import json
import sys

d = json.load(open(sys.argv[1]))
assert "uki" in d["files"], "no uki in the manifest"
h = hashlib.sha256(open(sys.argv[2], "rb").read()).hexdigest()
assert d["files"]["uki"]["sha256"] == h, (d["files"]["uki"]["sha256"], h)
EOF

# The key this run made, enrolled as PK, KEK and db: with virt-fw-vars,
# here or in the CI VM, as where it is installed.
openssl x509 -in "$crt" -outform DER -out "$CHECK/sb.der"
vars=$CHECK/sb-vars.fd
if command -v virt-fw-vars >/dev/null; then
	virt-fw-vars --input "$dir/vars.fd" --output "$vars" \
		--set-pk "$guid" "$CHECK/sb.der" --add-kek "$guid" "$CHECK/sb.der" \
		--add-db "$guid" "$CHECK/sb.der" --sb >/dev/null
elif limactl shell werewolf-ci-24.04 -- true >/dev/null 2>&1; then
	limactl copy "$CHECK/sb.der" werewolf-ci-24.04:/tmp/sb.der
	limactl copy "$dir/vars.fd" werewolf-ci-24.04:/tmp/vars.fd
	limactl shell werewolf-ci-24.04 -- virt-fw-vars --input /tmp/vars.fd \
		--output /tmp/sb-vars.fd --set-pk "$guid" /tmp/sb.der \
		--add-kek "$guid" /tmp/sb.der --add-db "$guid" /tmp/sb.der --sb >/dev/null
	limactl copy werewolf-ci-24.04:/tmp/sb-vars.fd "$vars"
else
	say "neither virt-fw-vars nor the werewolf-ci-24.04 VM to enroll the key"
fi

mkdir -p "$CHECK/sb/EFI/BOOT"
rm -f "$CHECK/sb/EFI/BOOT/BOOTAA64.EFI"
cp "$uki" "$CHECK/sb/EFI/BOOT/BOOTAA64.EFI"
printf 'FS0:\\EFI\\BOOT\\BOOTAA64.EFI\r\n' >"$CHECK/sb/startup.nsh"

boot() { # boot VARS LOG BOOTS-OR-REFUSED, then QEMU's arguments
	rm -f "$CHECK/sb-run.fd"
	cp "$1" "$CHECK/sb-run.fd"
	log=$2
	wanted=$3
	shift 3
	if test/boot secureboot - "$log" "$@" \
		-drive if=pflash,format=raw,file="$dir/code.fd",readonly=on \
		-drive if=pflash,format=raw,file="$CHECK/sb-run.fd" \
		-drive id=sbdisk,if=none,file=fat:rw:"$CHECK/sb",format=raw \
		-device virtio-blk-pci,drive=sbdisk \
		-netdev user,id=n0 -device virtio-net-pci,netdev=n0,romfile=; then
		[ "$wanted" = boots ] || fail "the changed image booted"
	else
		[ "$wanted" = refused ] || fail "the signed image did not boot"
		grep -a -q 'Access Denied' "$log" ||
			fail "no Access Denied for the changed image"
	fi
}

# The signed image must boot with its posture line whole: a line the
# serial port broke mid-print can still parse, so a boot whose line lacks
# the failures this image surely has is tried once more.
whole() { # whole LOG
	python3 - "$1" <<'EOF'
import re
import sys

t = re.sub(r"\[\s*\d+\.\d+\][^\n]*\n", "", open(sys.argv[1], errors="replace").read().replace("\r", ""))
m = re.search(r"posture: fail=(\S*) pass=", t)
sys.exit(0 if m and "boot-rollback-protected" in m.group(1) and "boot-sig-enforced" in m.group(1) else 1)
EOF
}

signed_boot() { # signed_boot VARS LOG, then QEMU's arguments
	vars=$1
	log=$2
	shift 2
	for try in 1 2; do
		if boot "$vars" "$log" boots "$@"; then
			whole "$log" && return 0
			echo "werewolf-check: the posture line arrived broken; booting again"
		fi
	done
	fail "the signed image did not boot, or its posture line never came whole"
}

signed_boot "$vars" "$log" "$@"
cp "$uki" "$CHECK/sb-tampered.efi"
python3 - "$CHECK/sb-tampered.efi" <<'EOF'
import sys
d = bytearray(open(sys.argv[1], "rb").read())
off = len(d) // 3 * 2
d[off] ^= 0xff
open(sys.argv[1], "wb").write(d)
EOF
cp "$CHECK/sb-tampered.efi" "$CHECK/sb/EFI/BOOT/BOOTAA64.EFI"
boot "$vars" "$CHECK/secureboot-tamper.log" refused "$@"
echo "pass   secureboot        the release's signed UKI boots under Secure Boot; a changed one is refused"
