# The login page answers through Caddy. PHP is on loopback. 8080 is
# 0x1F90. 9001 is 0x2329 and 9002 is 0x232A: the supervisor port and
# the image's public FastCGI, neither of which is open. 3306 is
# 0x0CEA and 6379 is 0x18EB, both loopback.
ok  misp-login   i=0; until wget -q -T 5 --no-check-certificate -O /tmp/misp-login.html https://localhost/users/login; do i=$((i + 1)); [ $i -le 300 ] || { echo "no login in 300 s"; exit 1; }; sleep 1; done; grep -qi password /tmp/misp-login.html
ok  misp-user    p=$(head -n 1 /run/cgroup/svc/misp/cgroup.procs); u=$(grep '^_oci-misp:' /etc/passwd | cut -d: -f3); [ "$u" -ge 65536 ] && grep -q "^Uid:[[:space:]]*$u[[:space:]]" /proc/$p/status && grep -q '^CapEff:[[:space:]]*0000000000000000$' /proc/$p/status && grep -q '^NoNewPrivs:[[:space:]]*1' /proc/$p/status
ok  misp-bind    grep -qi '0100007F:1F90 ' /proc/net/tcp && ! grep -qi '00000000:1F90 ' /proc/net/tcp && ! grep -qi ':2329 ' /proc/net/tcp && ! grep -qi ':232A ' /proc/net/tcp
ok  misp-db      grep -qi '0100007F:0CEA ' /proc/net/tcp && ! grep -qi '00000000:0CEA ' /proc/net/tcp && grep -qi '0100007F:18EB ' /proc/net/tcp
ok  misp-serve   found=0; for p in $(cat /run/cgroup/svc/misp/cgroup.procs); do c=$(cat /proc/$p/comm); case $c in python*|supervisord) echo "unexpected $c"; exit 1;; esac; [ "$c" = misp-serve ] && found=1; done; [ "$found" = 1 ]
ok  misp-secrets p=$(head -n 1 /run/cgroup/svc/misp/cgroup.procs); e=$(tr '\0' '\n' </proc/$p/environ); printf '%s\n' "$e" | grep -qx 'MYSQL_PASSWORD=misp' && printf '%s\n' "$e" | grep -qx 'ENABLE_REDIS_EMPTY_PASSWORD=true' && ! printf '%s\n' "$e" | grep -qx 'GPG_PASSPHRASE=passphrase' && ! printf '%s\n' "$e" | grep -qx 'SUPERVISOR_PASSWORD=supervisor' && ! printf '%s\n' "$e" | grep -qx 'ADMIN_PASSWORD=admin'
ok  misp-published  wget -q -T 10 --no-check-certificate -S -O /tmp/misp-no.html --post-data 'data[User][email]=admin@admin.test&data[User][password]=admin' https://localhost/users/login 2>&1 | grep -Eq 'HTTP/[^ ]* (200|401|403)' && ! grep -qi '/events/index' /tmp/misp-no.html
