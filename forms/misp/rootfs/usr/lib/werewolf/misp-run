# misp-run: bash, inside the MISP image, as _oci-misp
# (forms/misp/form.yaml). One script. It refuses a short password and the
# ones the image would publish, makes two passwords of its own, and
# replaces itself with the image's entrypoint. supervisord stays in the
# foreground. The host has no shell.
set -eu
umask 077
pw=$(cat /tmp/admin-password)
rm -f /tmp/admin-password
case $pw in
*" "*|*"'"*|*'"'*|*'\'*|*$'\n'*|admin|example|passphrase|redispassword|supervisor)
	echo "misp-run: refusing that password" >&2
	exit 1
	;;
esac
[ "${#pw}" -ge 12 ] || {
	echo "misp-run: password shorter than 12" >&2
	exit 1
}
mkdir -p /data /var/www/MISP/app/Config /var/www/MISP/app/files /var/www/MISP/app/tmp
if [ ! -s /data/gpg-pass ]; then
	/usr/bin/openssl rand -base64 24 >/data/gpg-pass
	/usr/bin/openssl rand -base64 24 >/data/supervisor-pass
fi
export GPG_PASSPHRASE="$(tr -d '\n' </data/gpg-pass)"
export SUPERVISOR_PASSWORD="$(tr -d '\n' </data/supervisor-pass)"
export ADMIN_PASSWORD="$pw"
export MISP_ADMIN_PASSPHRASE="$pw"
if [ ! -f /var/www/MISP/app/Config/config.php ] && [ -d /var/www/MISP/app/Config.default ]; then
	cp -a /var/www/MISP/app/Config.default/. /var/www/MISP/app/Config/
fi
exec /usr/bin/bash /entrypoint.sh
