# Caddy for the continuwuity form: HTTPS at the server's name
# (SERVER_NAME; howl --domain), with a certificate Caddy gets itself, and
# :80 sent there. Continuwuity is behind it on loopback. leash starts
# Caddy (etc/sv/caddy/service) as caddy.
{
	admin off
	log {
		output stderr
		format json
	}
	storage file_system /data/svc/caddy
	servers {
		timeouts {
			read_header 10s
			idle 2m
		}
		protocols h1 h2
	}
}

https://{$SERVER_NAME} {
	encode zstd gzip
	header -Server
	reverse_proxy 127.0.0.1:8008
}
