#!/bin/sh
# forms/bloodhound/test/config DIR: the administrator's password, Neo4j's
# password (the same bytes for Neo4j and for BloodHound), and the domain.
set -eu
mkdir -p "$1/neo4j" "$1/bloodhound" "$1/caddy"
umask 077
printf '%s' werewolf-check-pass-1 >"$1/bloodhound/admin-password"
printf '%s' werewolf-check-pass-2 >"$1/neo4j/neo4j-password"
printf '%s' werewolf-check-pass-2 >"$1/bloodhound/graph-password"
echo '{"domain":"localhost"}' >"$1/bloodhound/settings.json"
echo '{"domain":"localhost"}' >"$1/caddy/settings.json"
