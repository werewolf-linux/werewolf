exec    /usr/bin/tailscaled --tun=userspace-networking --port=41641 --state=/data/svc/tailscale/tailscaled.state --statedir=/data/svc/tailscale --socket=/run/svc/tailscale/tailscaled.sock --config=/etc/tailscale/config.json
user    tailscale
pledge  stdio rpath wpath inet unix netlink connect listen proc
read    /etc/tailscale
config  auth-key /run/config/tailscale/auth_key
# HTTPS to coordination and DERP relays; DNS; SSH to advertised subnets.
connect tcp/443 tcp/53 tcp/22
memory  512
nofile  4096
env     HOME=/data/svc/tailscale
env     TMPDIR=/run/svc/tailscale
env     GOMEMLIMIT=384MiB
